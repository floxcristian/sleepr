# Configuración de npm/pnpm para el proyecto Sleepr

# Deshabilitar progreso para logs más limpios en CI/Docker
progress=false

# Reducir nivel de logs
loglevel=warn

# Auto instalar peer dependencies (útil para pnpm)
auto-install-peers=true

# Permitir dependencias que no coincidan exactamente
strict-peer-dependencies=false

# Configuración de cache (útil para CI)
# cache=/tmp/npm-cache

# Registry por defecto (puedes cambiarlo si usas uno privado)
registry=https://registry.npmjs.org/
